{
  "expo": {
    "name": "GuardianAngelApp",
    "slug": "GuardianAngelApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "guardianangelapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Guardian Angel uses your location to send emergency alerts with a live map link.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Guardian Angel uses your location for emergency safety workflows.",
        "NSPhotoLibraryUsageDescription": "Allow Guardian Angel to attach photos to evidence journal entries.",
        "NSMicrophoneUsageDescription": "Allow Guardian Angel to record voice notes for evidence journal entries.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "SEND_SMS",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-mail-composer",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Guardian Angel to access your location for emergency intervention alerts.",
          "locationWhenInUsePermission": "Allow Guardian Angel to access your location for emergency intervention alerts.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
