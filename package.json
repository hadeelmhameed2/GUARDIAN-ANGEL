{
  "name": "guardianangelapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "cf:hash-password": "node scripts/hash-password.mjs",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist --project-name guardianangelapp --branch main --commit-dirty=true"
  },
  "dependencies": {
